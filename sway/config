exec systemctl --user import-environment DISPLAY WAYLAND_DISPLAY SWAYSOCK XDG_CURRENT_DESKTOP
exec systemctl --user start wayvnc.service

set $mod Mod4
set $left h
set $down j
set $up k
set $right l
set $term foot
exec_always export TERMINAL=/usr/bin/foot
set $menu rofi -show combi
bindsym $mod+Shift+v exec cliphist list | rofi -dmenu | cliphist decode | wl-copy
bindsym $mod+F8 exec ~/.config/sway/shift-spam.sh
exec /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1
exec keyd-application-mapper
exec wl-paste --type text --watch cliphist store
exec wl-paste --type image --watch cliphist store
set $background "/home/blaise/Pictures/RustFerrisBg.jpg"
output * bg $background fill

set $monitor "HP Inc. HP U28 4K HDR 1CR20606PP"
set $second_monitor "AOC 27G2WG3- 1TMP6HA010233"
output eDP-1 resolution 1920x1080 position 3840,0
output $monitor mode  3840x2160@59.997Hz position 0,0
exec waylock

workspace 1 output eDP-1
workspace 3 output eDP-1
workspace 5 output eDP-1

workspace 2 output $monitor
workspace 4 output $monitor
workspace 6 output $monitor

assign [app_id="zen" ] workspace 2
assign [app_id="google-chrome" ] workspace 2
assign [class="steam" ] workspace 3
assign [app_id="discord" ] workspace 4
assign [class="rviz2" ] workspace 5
assign [class="Gazebo GUI" ] workspace 6

# RoboMaster referee software (see ~/RoboMaster/rm-launch.sh)
assign [class="robomasterclient.exe" ] workspace 5
# The client normally runs inside a Wine virtual desktop (rm-launch.sh), which
# is what stops it hijacking the compositor with a real fullscreen window.
assign [class="explorer.exe" title="RMClient"] workspace 5
assign [class="robomasterengine.exe" ] workspace 6
assign [class="rmserverlogclient.exe" ] workspace 7
# The client spawns a conhost window per RMClientAssist_* helper. Match on
# title too — bare class="conhost.exe" would catch every Wine console.
assign [class="conhost.exe" title="RMClientDaemon"] workspace 7
# Wine's crash dialog ("Program Error") — otherwise it pops up over the client.
assign [class="winedbg.exe" ] workspace 7

# after-resume is driven by logind's PrepareForSleep, not by the lid switch, so
# it unblanks on every wake even if the lid-open event never reaches sway. This
# is the belt to the bindswitch braces below — on 2026-08-03 the panel was left
# DPMS-off across a suspend and nothing turned it back on.
exec swayidle  \
	timeout 310 'swaymsg "output * dpms off"' \
	resume 'swaymsg "output * dpms off" && swaymsg "output * dpms on"' \
	before-sleep 'waylock' \
	after-resume 'swaymsg "output * dpms on"'
exec ~/.config/sway/idle-inhibit-suspend-guard.sh
bindsym $mod+f9 exec waylock
# bindswitch runs a sway command, not a shell command — `swaymsg "..."` here
# parses as the unknown command `swaymsg` and silently does nothing, which is
# how the lid could turn the panel off (via swayidle) but never turn it back on.
bindswitch --locked lid:on output eDP-1 dpms off
bindswitch --locked lid:off output eDP-1 dpms on

input type:touchpad {
	dwt enabled
	tap disabled
	natural_scroll enabled
	middle_emulation enabled
	click_method clickfinger
}

input type:pointer {
	dwt enabled
	tap disabled
	pointer_accel -0.2
	accel_profile "flat"
}
input "2:10:TPPS/2_Elan_TrackPoint" {
	scroll_method on_button_down
	scroll_button BTN_MIDDLE
	scroll_factor 0.5
	scroll_button_lock enabled
}

input type:keyboard {
	xkb_options caps:escape
	xkb_layout "us"
}
