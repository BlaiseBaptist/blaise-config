// -*- mode: jsonc -*-
// Two bar instances, one per output, sharing every module definition via
// modules.jsonc. The split exists because the two panels run at different sway
// scales: the HP 4K is at scale 1.5 (a preference, changed by hand from time to
// time) and the laptop at scale 1, and the two panels differ in density
// (157ppi vs 143ppi), so identical px metrics would render smaller on the 4K
// one. These are the base values scaled by 0.73; rederive them along with
// style-hidpi.css if the 4K scale changes again.
//
// For duplicate keys the *including* object wins over the included file, so
// the values set here override modules.jsonc; eDP-1 sets none and inherits.
// The matching CSS lives in style-hidpi.css, scoped by the "name" class.
[
  {
    "output": "HP Inc. HP U28 4K HDR 1CR20606PP",
    "name": "hidpi",
    "height": 22,
    "spacing": 4,
    "tray": {
      "icon-size": 15,
      "spacing": 7,
      "icons": {
        "blueman": "bluetooth",
        "TelegramDesktop": "$HOME/.local/share/icons/hicolor/16x16/apps/telegram.png"
      },
      "format": "tray"
    },
    "include": ["/home/blaise/.config/waybar/modules.jsonc"]
  },
  {
    "output": "eDP-1",
    "name": "lodpi",
    "include": ["/home/blaise/.config/waybar/modules.jsonc"]
  }
]
