// -*- mode: jsonc -*-
{
  // Waybar is launched with `exec` from the sway config rather than as
  // swaybar's status_command, so `swaymsg reload` no longer restarts it (a
  // restart drops Electron tray icons such as Discord's). CSS edits apply live;
  // after editing this file run `pkill -SIGUSR2 waybar`.
  "reload_style_on_change": true,
  "height": 30,
  "spacing": 4,
  "modules-left": [
    "sway/workspaces",
    "sway/mode",
    "sway/scratchpad",
    // Sway draws no titlebars (default_border pixel), so the focused window's
    // title lives here. Left rather than centre so a long title cannot run
    // into the right-hand pills.
    "sway/window",
    "custom/media"
  ],
  "modules-center": [],
  // Related modules are grouped so each group renders as one pill (see
  // style.css). A group's CSS id is the part after "group/", e.g. #hardware.
  "modules-right": [
    "group/controls",
    "network",
    "group/hardware",
    "custom/bluetooth-devices",
    "group/applets",
    "group/system"
  ],
  "group/controls": {
    "orientation": "inherit",
    "modules": ["backlight", "pulseaudio"]
  },
  "group/hardware": {
    "orientation": "inherit",
    "modules": ["cpu", "temperature", "custom/gpuinfo", "memory"]
  },
  "group/applets": {
    "orientation": "inherit",
    "modules": ["idle_inhibitor", "tray", "custom/notification", "power-profiles-daemon"]
  },
  "group/system": {
    "orientation": "inherit",
    "modules": ["battery", "clock", "custom/power"]
  },
  "custom/notification": {
    "format": "{icon}",
    "format-icons": {
      "notification": "󰂞",
      "none": "󰂚",
      "dnd-notification": "󰂛",
      "dnd-none": "󰂛",
      "inhibited-notification": "󰂞",
      "inhibited-none": "󰂚",
      "dnd-inhibited-notification": "󰂛",
      "dnd-inhibited-none": "󰂛"
    },
    "tooltip": false,
    "return-type": "json",
    "exec-if": "which swaync-client",
    "exec": "swaync-client -swb",
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "escape": true
  },
  "custom/bluetooth-devices": {
    "format": "{}",
    "exec": "sleep 1 && $HOME/.config/waybar/scripts/bluetooth-devices.sh",
    "interval": 10,
    "on-click": "foot bluetoothctl"
  },
  // "expand" gives the title all the space the other modules leave, and it is
  // cut off with "…" only where that space ends. max-length is just a high cap
  // (setting one is what enables the "…" truncation at all).
  "sway/window": {
    "format": "{title}",
    "expand": true,
    "max-length": 400,
    "tooltip": false
  },
  "sway/mode": {
    "format": "<span style=\"italic\">{}</span>"
  },
  "sway/scratchpad": {
    "format": "{icon} {count}",
    "show-empty": false,
    "format-icons": [
      "",
      ""
    ],
    "tooltip": true,
    "tooltip-format": "{app}: {title}"
  },
  "mpd": {
    "format": "{stateIcon} {consumeIcon}{randomIcon}{repeatIcon}{singleIcon}{artist} - {album} - {title} ({elapsedTime:%M:%S}/{totalTime:%M:%S}) ⸨{songPosition}|{queueLength}⸩ {volume}% ",
    "format-disconnected": "Disconnected ",
    "format-stopped": "{consumeIcon}{randomIcon}{repeatIcon}{singleIcon}Stopped ",
    "unknown-tag": "N/A",
    "interval": 5,
    "consume-icons": {
      "on": " "
    },
    "random-icons": {
      "off": "<span color=\"#f53c3c\"></span> ",
      "on": " "
    },
    "repeat-icons": {
      "on": " "
    },
    "single-icons": {
      "on": "1 "
    },
    "state-icons": {
      "paused": "",
      "playing": ""
    },
    "tooltip-format": "MPD (connected)",
    "tooltip-format-disconnected": "MPD (disconnected)"
  },
  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "",
      "deactivated": ""
    },
    "on-click": "$HOME/.config/waybar/scripts/toggle-suspend-inhibit.sh"
  },
  "tray": {
    "icon-size": 18,
    "spacing": 10,
    "icons": {
      "blueman": "bluetooth",
      "TelegramDesktop": "$HOME/.local/share/icons/hicolor/16x16/apps/telegram.png"
    },
    "format": "tray"
  },
  "clock": {
    "timezone": "America/Indianapolis",
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
    "format-alt": "{:%Y-%m-%d}"
  },
  "cpu": {
    // Usage thresholds that add the .warning / .critical classes (style.css).
    "states": {
      "warning": 70,
      "critical": 90
    },
    "format": "{usage}% ",
    "on-click": "foot btop"
  },
  "memory": {
    "format": "{}% "
  },
  "temperature": {
    // Adds .warning / .critical, coloured like the cpu states (style.css).
    "warning-threshold": 75,
    "critical-threshold": 90,
    "format": "{temperatureC}°C {icon}",
    "format-icons": [
      "",
      "",
      ""
    ]
  },
  "backlight": {
    "format": "{percent}% {icon}",
    "format-icons": [
      ""
    ]
  },
  "battery": {
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{capacity}% {icon}",
    "format-full": "{capacity}% {icon}",
    "format-charging": "{capacity}% ",
    "format-plugged": "{capacity}% ",
    "format-alt": "{time} {icon}",
    // Time left for format-alt (click the battery): {m} is zero-padded minutes.
    "format-time": "{H}:{m}",
    "format-icons": [
      "",
      "",
      "",
      "",
      ""
    ]
  },
  "power-profiles-daemon": {
    "format": "{icon}",
    "tooltip-format": "Power profile: {profile}\nDriver: {driver}",
    "tooltip": true,
    "format-icons": {
      "default": "",
      "performance": "",
      "balanced": "",
      "power-saver": ""
    }
  },
  "network": {
    "format-wifi": "{essid}  {bandwidthUpBytes:>6}   {bandwidthDownBytes:>6} ",
    "format-ethernet": " {bandwidthUpBytes:>6}   {bandwidthDownBytes:>6} ",
    "tooltip-format": "{ifname} via {gwaddr} ",
    "format-linked": "{ifname} (reconnecting…) ",
    "format-disconnected": "Disconnected ⚠",
    "format-alt": "{ifname}: {ipaddr}/{cidr}",
    "interval": 1
  },
  "pulseaudio": {
    "format": "{volume}% {icon} {format_source}",
    "format-bluetooth": "{volume}% {icon} {format_source}",
    "format-bluetooth-muted": " {icon} {format_source}",
    "format-muted": " {format_source}",
    "format-source": "{volume}% ",
    "format-source-muted": "",
    "format-icons": {
      "headphone": "",
      "hands-free": "",
      "headset": "",
      "phone": "",
      "portable": "",
      "car": "",
      "default": [
        "",
        "",
        ""
      ]
    },
    "on-click": "pavucontrol"
  },
  "custom/media": {
    "format": "{text}",
    "return-type": "json",
    "max-length": 100,
    "escape": true,
    "exec": "$HOME/.config/waybar/scripts/mediaplayer.py 2> /dev/null",
    // playerctl with no -p acts on its first player, which is the same
    // most-recently-active one mediaplayer.py picks to display, so the clicks
    // control whatever the module is showing. Scroll seeks rather than changing
    // volume; the volume pill on the right already owns that gesture.
    //
    // Right click dismisses the pill instead of skipping: SIGUSR1 tells the
    // script to stop printing the current track, and it reappears on its own
    // at the next track or player. There is no "previous track" binding; that
    // is what freed up middle click for "next".
    "on-click": "playerctl play-pause",
    "on-click-middle": "playerctl next",
    // Two things make the pattern this fussy. The "python3 " prefix keeps it
    // off the /bin/sh wrapper waybar keeps around the script, which would
    // otherwise take the signal and die, taking the module's output with it.
    // The [m] keeps it off the shell waybar spawns to run this very command.
    "on-click-right": "pkill -USR1 -f 'python3 .*waybar/scripts/[m]ediaplayer.py'",
    "on-scroll-up": "playerctl position 10+",
    "on-scroll-down": "playerctl position 10-"
  },
  "custom/power": {
    "format": "⏻ ",
    "tooltip": false,
    "menu": "on-click",
    "menu-file": "$HOME/.config/waybar/power_menu.xml",
    "menu-actions": {
      "shutdown": "shutdown",
      "reboot": "reboot",
      "suspend": "systemctl suspend",
      "hibernate": "systemctl hibernate"
    }
  },
  "custom/gpuinfo": {
    "format": "{text} 󰢮",
    "exec": "$HOME/.config/waybar/scripts/gpuinfo.sh",
    "return-type": "json",
    "interval": 1,
    "tooltip": true,
    "on-click": "foot nvtop"
  }
}